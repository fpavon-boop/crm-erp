    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.9.0-beta.17": true,
    "@prisma/client@5.22.0": true,
