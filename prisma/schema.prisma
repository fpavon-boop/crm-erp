// =============================================================================
// Automation rules
// =============================================================================

enum AutomationTrigger {
  EMAIL_RECEIVED_NO_REPLY
  INVOICE_OVERDUE
  ORDER_PENDING
  LOW_STOCK
  ORDER_STATUS_CHANGED
  INVOICE_CREATED
  SCHEDULE
}

model AutomationRule {
  id          String            @id @default(cuid())
  name        String
  trigger     AutomationTrigger
  conditions  Json?
  actions     Json
  active      Boolean           @default(true)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  logs        AutomationLog[]
}

model AutomationLog {
  id          String         @id @default(cuid())
  ruleId      String?
  rule        AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  entityType  String?
  entityId    String?
  success     Boolean        @default(true)
  message     String?
  createdAt   DateTime       @default(now())
}

// Phase 13 (automation system hardening): the standardized execution
// contract every built-in scheduled job (and the WooCommerce sync) now
// runs through — one row per job invocation, not per sub-event the way
// AutomationLog already is. Kept alongside AutomationLog rather than
// replacing it: AutomationLog's existing per-item call sites (WooCommerce
// sync warnings, the WhatsApp webhook's per-message failures) stay as they
// are, granular within one job run; this table is the coarser, job-level
// record — did this whole invocation start, run, finish, or fail, and
// why. See docs/AUTOMATION_SYSTEM.md.
enum AutomationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYING
}

model AutomationJobRun {
  id           String              @id @default(cuid())
  jobKey       String
  trigger      String
  conditions   Json?
  action       String?
  status       AutomationJobStatus @default(PENDING)
  entityType   String?
  entityId     String?
  attempt      Int                 @default(1)
  maxAttempts  Int                 @default(1)
  errorMessage String?
  errorStack   String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([jobKey, status])
  @@index([status, createdAt])
}

// Phase 13 (automation system hardening): the one shared idempotency
// primitive every "don't do this twice" call site claims a row from
// before acting — the exact same create()-races-on-a-unique-column
// pattern already established in src/lib/automations/tick-lock.ts, generalized
// to any caller instead of one hardcoded lock row. `resultRef` lets a
// retried caller look up and return the original outcome (e.g. a
// CommunicationLog id) instead of re-doing the side effect. See
// src/lib/automations/idempotency.ts and docs/AUTOMATION_SYSTEM.md.
model IdempotencyKey {
  key       String   @id
  scope     String
  resultRef String?
  createdAt DateTime @default(now())

  @@index([scope])
}

// Phase 8: a single-row lease/lock so the in-process scheduler
// (src/instrumentation-node.ts), the optional standalone worker
// (src/worker/index.ts), and the manual/Cron-triggered
// POST /api/automations/run route can never run an automations+email-sync
// tick at the same time as each other (SYSTEM_AUDIT.md D4) — whichever of
// the three has none of them currently deployed is a matter of
// configuration, not something the app can rely on, so the lock protects
// correctness regardless of which trigger(s) are actually wired up.
// `lockedAt: null` means free; a non-null `lockedAt` older than the lease
// window is treated as free too (self-healing if a process crashes
// mid-tick without releasing it) — see
// src/lib/automations/tick-lock.ts.
model ScheduledTickLock {
  id       String    @id
  lockedAt DateTime?
  runId    String?
}

