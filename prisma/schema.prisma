// =============================================================================
// Sales channel abstraction (docs/SALES_CHANNEL_ARCHITECTURE.md)
// =============================================================================
//
// Purely additive: this is a new, generic landing spot for multi-channel
// external-identity mapping, separate from the existing WooCommerce-specific
// `externalSource`/`externalId` columns already on Company/Product/
// ProductVariant/SalesOrder/Payment. Those keep working exactly as they do
// today — nothing in the WooCommerce sync code reads or writes
// ChannelReference. Amazon/Walmart/TikTok Shop have no live integration; this
// only gives them a schema to target when that work is scoped later.

enum SalesChannel {
  WOOCOMMERCE
  AMAZON
  WALMART
  TIKTOK_SHOP
}

model ChannelReference {
  id                 String            @id @default(cuid())
  channel            SalesChannel
  entityType         RelatedEntityType
  entityId           String
  externalOrderId    String?
  externalCustomerId String?
  externalProductId  String?
  externalSku        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([channel, entityType, entityId])
  @@index([channel, externalOrderId])
  @@index([channel, externalCustomerId])
  @@index([channel, externalProductId])
  @@index([channel, externalSku])
}

// =============================================================================
// Marketing automation (docs/MARKETING_AUTOMATION_ARCHITECTURE.md)
// =============================================================================
//
// Purely additive and isolated from the core ERP. Rules for this section:
// - No Prisma relation to any core model. Products, variants, companies,
//   contacts and users are referenced by plain String IDs ("soft
//   references"), so nothing here adds a back-relation field to a core model
//   or a foreign key that could cascade into, or block, a core delete.
// - Relations exist only between Marketing* models.
// - No core enum is extended; marketing defines its own.
// - Platform credentials (Meta, TikTok, Canva, CapCut) are never stored here.
//   They live in n8n; SocialAccount only records which n8n credential to use.

/// Shared lifecycle for every reviewable marketing entity. AI output always
/// enters as AI_GENERATED and must pass HUMAN_REVIEW -> APPROVED (ADMIN only)
/// before it can be SCHEDULED or PUBLISHED.
enum MarketingApprovalStatus {
  DRAFT
  AI_GENERATED
  HUMAN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum MarketingChannel {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WHATSAPP
  EMAIL
  WEBSITE
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialAccountStatus {
  ACTIVE
  DISCONNECTED
  REVOKED
}

enum MarketingContentType {
  POST_COPY
  CAPTION
  AD_COPY
  EMAIL
  WHATSAPP_MESSAGE
  BLOG
  VIDEO_SCRIPT
  HASHTAGS
  POST_CONCEPT
}

enum MarketingAssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MarketingAssetSource {
  UPLOAD
  CANVA
  CAPCUT
  AI_GENERATED
  N8N
  EXTERNAL_URL
  /// Read-only link to an existing core Document (entityType PRODUCT); the
  /// file is never copied, moved or modified.
  ERP_DOCUMENT
}

enum MarketingAssetOrientation {
  SQUARE
  VERTICAL
  LANDSCAPE
}

enum MarketingTemplateKind {
  SOCIAL_POST
  EMAIL
  WHATSAPP
  VIDEO
  DESIGN
}

enum MarketingTemplateProvider {
  INTERNAL
  CANVA
  CAPCUT
  META_WHATSAPP
}

enum VideoRenderStatus {
  NOT_STARTED
  QUEUED
  RENDERING
  COMPLETED
  FAILED
}

enum MarketingJobType {
  CONTENT_GENERATION
  VIDEO_RENDER
  SOCIAL_PUBLISH
  MESSAGE_SEND
  ANALYTICS_SYNC
}

enum MarketingScheduleStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED
  CANCELLED
}

enum MarketingApprovalTarget {
  CAMPAIGN
  CONTENT
  ASSET
  VIDEO_PROJECT
  SOCIAL_POST
}

enum MarketingSafeguardVerdict {
  PASS
  WARN
  BLOCK
}

enum MarketingLanguage {
  EN
  ES
}

/// Language-neutral brand identity. Per-language voice/tone/banned phrases
/// live in MarketingBrandLocale; the EN⇄ES glossary in MarketingBrandTerm.
/// `bannedPhrases` here applies to every language.
model MarketingBrandProfile {
  id              String            @id @default(cuid())
  name            String
  isDefault       Boolean           @default(false)
  primaryLanguage MarketingLanguage @default(EN)
  voice           String?
  tone            String?
  targetAudience  String?
  guidelines      String?           @db.Text
  bannedPhrases   String[]
  defaultHashtags String[]
  primaryColor    String?
  secondaryColor  String?
  /// [{ name, hex, role }] — full palette; primary/secondaryColor mirror it.
  colorPalette    Json?
  logoUrl         String?
  /// Physical postal address printed in every marketing email (CAN-SPAM).
  postalAddress   String?
  active          Boolean           @default(true)
  createdById     String? // soft ref: User.id
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  campaigns MarketingCampaign[]
  templates MarketingTemplate[]
  locales   MarketingBrandLocale[]
  terms     MarketingBrandTerm[]
}

/// Approved brand definition for one language (one row each for EN and ES).
model MarketingBrandLocale {
  id                 String                @id @default(cuid())
  brandProfileId     String
  brandProfile       MarketingBrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  language           MarketingLanguage
  voice              String
  tone               String
  tagline            String?
  guidelines         String?               @db.Text
  bannedPhrases      String[]
  requiredDisclaimer String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([brandProfileId, language])
}

/// Approved terminology. Rows sharing a `conceptKey` are translations of the
/// same concept (e.g. "brick-oven": EN "brick oven" / ES "horno de ladrillo").
/// `discouraged` lists variants the validator flags with `term` as the fix.
model MarketingBrandTerm {
  id             String                @id @default(cuid())
  brandProfileId String
  brandProfile   MarketingBrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  conceptKey     String
  language       MarketingLanguage
  term           String
  discouraged    String[]
  notes          String?
  createdAt      DateTime              @default(now())

  @@unique([brandProfileId, conceptKey, language])
  @@index([brandProfileId, language])
}

model MarketingCampaign {
  id                String                  @id @default(cuid())
  name              String
  objective         String?
  description       String?                 @db.Text
  status            MarketingApprovalStatus @default(DRAFT)
  channels          MarketingChannel[]
  brandProfileId    String?
  brandProfile      MarketingBrandProfile?  @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  audienceId        String?
  audience          MarketingAudience?      @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  // Soft refs to Product.id / ProductVariant.id — checked by the read-only
  // inventory + margin safeguard before approval and again before dispatch.
  productIds        String[]
  productVariantIds String[]
  discountPct       Decimal?                @db.Decimal(5, 2)
  startsAt          DateTime?
  endsAt            DateTime?
  createdById       String? // soft ref: User.id
  approvedById      String? // soft ref: User.id (ADMIN)
  approvedAt        DateTime?
  budget            Decimal?                @db.Decimal(14, 2)
  /// The user brief the strategy was generated from.
  sourcePrompt      String?                 @db.Text
  /// AI strategy: objectives, audience segments, channel mix, summary.
  strategy          Json?
  /// Last inventory + margin safeguard evaluation (see marketing/ai/safeguards.ts).
  safeguardSnapshot Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  contents      MarketingContent[]
  assets        MarketingAsset[]
  videoProjects VideoProject[]
  socialPosts   SocialPost[]
  schedules     MarketingSchedule[]
  analytics     MarketingAnalytics[]
  approvals     CampaignApproval[]

  @@index([status])
  @@index([startsAt])
}

model MarketingContent {
  id              String                  @id @default(cuid())
  campaignId      String
  campaign        MarketingCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel         MarketingChannel
  type            MarketingContentType
  title           String?
  body            String                  @db.Text
  hashtags        String[]
  language        String                  @default("en")
  version         Int                     @default(1)
  status          MarketingApprovalStatus @default(DRAFT)
  aiGenerated     Boolean                 @default(false)
  aiModel         String?
  promptId        String?
  prompt          MarketingPrompt?        @relation(fields: [promptId], references: [id], onDelete: SetNull)
  productIds      String[] // soft refs: Product.id
  reviewedById    String? // soft ref: User.id
  reviewedAt      DateTime?
  rejectionReason String?
  /// Pairs the EN and ES rows of one bilingual variant.
  variantGroupId  String?
  /// Terminology/compliance findings at generation time.
  compliance      Json?
  aiLogId         String? // soft ref: MarketingAiLog.id
  createdById     String? // soft ref: User.id
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  socialPosts SocialPost[]

  @@index([campaignId, status])
  @@index([status])
  @@index([variantGroupId])
}

model MarketingAsset {
  id               String                     @id @default(cuid())
  name             String?
  tags             String[]
  /// Nearest standard ratio label ("1:1", "9:16", "16:9", "4:5", ...) or "custom".
  aspectRatio      String?
  orientation      MarketingAssetOrientation?
  /// soft ref: Document.id when source = ERP_DOCUMENT
  sourceDocumentId String?
  archivedAt       DateTime?
  campaignId  String?
  campaign    MarketingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type        MarketingAssetType
  source      MarketingAssetSource
  url         String
  storageKey  String?
  externalId  String? // e.g. Canva design id / CapCut export id
  mimeType    String?
  sizeBytes   Int?
  width       Int?
  height      Int?
  durationSec Decimal?                @db.Decimal(8, 2)
  checksum    String?
  altText     String?
  status      MarketingApprovalStatus @default(DRAFT)
  productIds  String[] // soft refs: Product.id
  createdById String? // soft ref: User.id
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  videoOutputs VideoProject[] @relation("VideoProjectOutput")
  videoScenes  VideoScene[]

  @@unique([source, externalId])
  @@index([campaignId])
  @@index([sourceDocumentId])
  @@index([orientation])
}

model MarketingTemplate {
  id                 String                    @id @default(cuid())
  name               String
  kind               MarketingTemplateKind
  provider           MarketingTemplateProvider @default(INTERNAL)
  channel            MarketingChannel?
  externalTemplateId String?
  body               String?                   @db.Text
  description        String?
  /// Declared placeholder schema: [{ key, required, maxLength?, description?, custom? }].
  variables          Json?
  /// Placeholder keys the template uses (parsed from body / declarations on save).
  placeholders       String[]
  createdById        String? // soft ref: User.id
  brandProfileId     String?
  brandProfile       MarketingBrandProfile?    @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  active             Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  videoProjects VideoProject[]

  @@unique([provider, externalTemplateId])
}

enum VideoPlatform {
  TIKTOK
  INSTAGRAM_REELS
  FACEBOOK_REELS
}

enum VideoTextPosition {
  TOP
  CENTER
  BOTTOM
}

enum VideoTransition {
  CUT
  FADE
  SLIDE
  ZOOM
}

/// Lifecycle = status (DRAFT → HUMAN_REVIEW → APPROVED / REJECTED) + renderStatus
/// (QUEUED/RENDERING → COMPLETED / FAILED). Rendering requires approvedVersion
/// == version: any edit after approval bumps version and voids the approval.
model VideoProject {
  id                String                  @id @default(cuid())
  campaignId        String?
  campaign          MarketingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  templateId        String?
  template          MarketingTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title             String
  aspectRatio       String                  @default("9:16")
  targetDurationSec Int?
  script            String?                 @db.Text
  status            MarketingApprovalStatus @default(DRAFT)
  renderStatus      VideoRenderStatus       @default(NOT_STARTED)
  externalJobId     String?                 @unique // n8n execution / render job id
  outputAssetId     String?
  outputAsset       MarketingAsset?         @relation("VideoProjectOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  errorMessage      String?
  platform          VideoPlatform           @default(TIKTOK)
  language          MarketingLanguage       @default(EN)
  version           Int                     @default(1)
  approvedVersion   Int?
  approvedById      String? // soft ref: User.id (ADMIN)
  approvedAt        DateTime?
  audioAssetId      String? // soft ref: MarketingAsset.id (music / voiceover track)
  renderRequestedAt DateTime?
  renderedAt        DateTime?
  renderAttempts    Int                     @default(0)
  createdById       String? // soft ref: User.id
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  scenes      VideoScene[]
  socialPosts SocialPost[]

  @@index([campaignId])
  @@index([renderStatus])
}

model VideoScene {
  id             String          @id @default(cuid())
  videoProjectId String
  videoProject   VideoProject    @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  order          Int
  script         String?         @db.Text
  voiceover      String?         @db.Text
  onScreenText   String?
  /// What the renderer should show when no asset is assigned (or how to treat it).
  visualCue      String?         @db.Text
  textPosition   VideoTextPosition?
  /// Optional custom overlay box {x, y, width, height} as 0..1 fractions of the frame.
  textBox        Json?
  transition     VideoTransition @default(CUT)
  durationSec    Decimal?        @db.Decimal(8, 2)
  assetId        String?
  asset          MarketingAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  productId      String? // soft ref: Product.id
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([videoProjectId, order])
}

/// No tokens are stored: `n8nCredentialRef` names the credential inside n8n
/// that the publishing workflow should use.
model SocialAccount {
  id                String              @id @default(cuid())
  platform          SocialPlatform
  externalAccountId String
  handle            String?
  displayName       String?
  n8nCredentialRef  String?
  status            SocialAccountStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  posts SocialPost[]

  @@unique([platform, externalAccountId])
}

model SocialPost {
  id              String                  @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount           @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  campaignId      String?
  campaign        MarketingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentId       String?
  content         MarketingContent?       @relation(fields: [contentId], references: [id], onDelete: SetNull)
  videoProjectId  String?
  videoProject    VideoProject?           @relation(fields: [videoProjectId], references: [id], onDelete: SetNull)
  mediaAssetIds   String[] // MarketingAsset ids, in display order
  caption         String?                 @db.Text
  status          MarketingApprovalStatus @default(DRAFT)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  externalPostId  String?
  permalink       String?
  errorMessage    String?
  language        MarketingLanguage       @default(EN)
  /// Bumped on every edit; dispatch requires approvedVersion == version.
  version         Int                     @default(1)
  approvedVersion Int?
  approvedById    String? // soft ref: User.id (ADMIN)
  approvedAt      DateTime?
  compliance      Json?
  /// Stock/margin/price evaluation at approval; dispatch re-checks against it.
  safeguardSnapshot Json?
  /// The live MarketingSchedule job for this post (deterministic id).
  dispatchJobId   String?                 @unique
  /// Incremented only by an explicit retry after FAILED — part of the idempotency key.
  dispatchGeneration Int                  @default(0)
  /// Set when the signed package was accepted by n8n (phase DISPATCHED).
  dispatchedAt    DateTime?
  createdById     String? // soft ref: User.id
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  schedules MarketingSchedule[]
  analytics MarketingAnalytics[]

  @@unique([socialAccountId, externalPostId])
  @@index([status, scheduledFor])
  @@index([campaignId])
}

/// Outbox for work handed to n8n (architecture doc §4.1). `id` doubles as the
/// X-Mkt-Job-Id idempotency key sent with each dispatch.
model MarketingSchedule {
  id           String                  @id @default(cuid())
  jobType      MarketingJobType
  status       MarketingScheduleStatus @default(PENDING)
  runAt        DateTime
  campaignId   String?
  campaign     MarketingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialPostId String?
  socialPost   SocialPost?             @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  n8nWorkflow  String?
  payload      Json?
  result       Json?
  attempt      Int                     @default(0)
  maxAttempts  Int                     @default(3)
  lastError    String?
  /// Stable key sent to n8n with every attempt (Idempotency-Key header).
  idempotencyKey String?               @unique
  /// SHA-256 of the dispatch package; identical across retries.
  checksum     String?
  dispatchedAt DateTime?
  completedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, runAt])
  @@index([campaignId])
}

model MarketingAnalytics {
  id                String             @id @default(cuid())
  campaignId        String?
  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialPostId      String?
  socialPost        SocialPost?        @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  channel           MarketingChannel
  periodStart       DateTime
  periodEnd         DateTime
  impressions       Int                @default(0)
  reach             Int                @default(0)
  clicks            Int                @default(0)
  engagements       Int                @default(0)
  videoViews        Int                @default(0)
  conversions       Int                @default(0)
  spend             Decimal?           @db.Decimal(14, 2)
  // Attributed revenue is computed read-only from core orders and stored
  // here as a snapshot only — never written back to core.
  attributedRevenue Decimal?           @db.Decimal(14, 2)
  raw               Json?
  capturedAt        DateTime           @default(now())

  /// One row per post per reporting period (re-reports update it in place).
  @@unique([socialPostId, periodStart, periodEnd])
  @@index([campaignId, periodStart])
  @@index([socialPostId, periodStart])
}

/// Append-only decision log. `decidedById` must be an ADMIN (enforced in the
/// approvals service). The safeguard verdict at decision time is snapshotted.
model CampaignApproval {
  id                   String                     @id @default(cuid())
  campaignId           String
  campaign             MarketingCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetType           MarketingApprovalTarget
  targetId             String
  fromStatus           MarketingApprovalStatus
  toStatus             MarketingApprovalStatus
  decidedById          String // soft ref: User.id
  comment              String?
  safeguardVerdict     MarketingSafeguardVerdict?
  safeguardSnapshot    Json?
  warningsAcknowledged Boolean                    @default(false)
  createdAt            DateTime                   @default(now())

  @@index([campaignId, createdAt])
  @@index([targetType, targetId])
}

/// Audience DEFINITION only (filter rules over CRM contacts/companies). No
/// member list and no consent state is stored here: recipients are resolved
/// from the CRM at send time and consent/opt-out is read from the CRM
/// (WordPressLead.consentGiven + the CommunicationLog timeline). Email /
/// WhatsApp sends go through the core communications service only.
/// See src/marketing/audiences/.
model MarketingAudience {
  id             String           @id @default(cuid())
  name           String
  description    String?
  channel        MarketingChannel
  criteria       Json
  lastSizeCount  Int?
  lastComputedAt DateTime?
  createdById    String? // soft ref: User.id
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns MarketingCampaign[]
}

/// Versioned prompt library. Rows are immutable once used; edits create a
/// new version under the same key.
model MarketingPrompt {
  id           String   @id @default(cuid())
  key          String
  version      Int      @default(1)
  name         String
  purpose      String?
  systemPrompt String   @db.Text
  userTemplate String   @db.Text
  model        String?
  maxTokens    Int?
  variables    Json?
  active       Boolean  @default(true)
  createdById  String? // soft ref: User.id
  createdAt    DateTime @default(now())

  contents MarketingContent[]

  @@unique([key, version])
}

enum MarketingAiCallStatus {
  SUCCESS
  FAILED
  VALIDATION_FAILED
}

/// One row per marketing AI pipeline call (success or failure). Separate from
/// core AiGenerationLog / AiFeature so marketing never writes core audit
/// tables. Stores a hash of the (already redacted) prompt, never the prompt
/// or the model output, so no PII lands here.
model MarketingAiLog {
  id                String                     @id @default(cuid())
  templateKey       String
  templateVersion   Int
  status            MarketingAiCallStatus
  provider          String?
  model             String?
  attempts          Int                        @default(0)
  fallbackUsed      Boolean                    @default(false)
  latencyMs         Int
  inputTokens       Int?
  outputTokens      Int?
  requestId         String?
  promptHash        String
  redactions        Json?
  errorKind         String?
  errorMessage      String?
  complianceVerdict MarketingSafeguardVerdict?
  campaignId        String? // soft ref: MarketingCampaign.id
  contentId         String? // soft ref: MarketingContent.id
  requestedById     String? // soft ref: User.id
  createdAt         DateTime                   @default(now())

  @@index([templateKey, createdAt])
  @@index([status, createdAt])
  @@index([campaignId])
}

enum MarketingWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Inbound n8n callbacks, deduplicated on (source, eventId). Marketing-owned:
/// replay protection never writes the core IdempotencyKey table.
model MarketingWebhookEvent {
  id          String                      @id @default(cuid())
  source      String
  eventId     String
  type        String
  jobId       String?
  status      MarketingWebhookEventStatus @default(RECEIVED)
  attempts    Int                         @default(1)
  outcome     Json?
  error       String?
  receivedAt  DateTime                    @default(now())
  processedAt DateTime?

  @@unique([source, eventId])
  @@index([jobId])
  @@index([status, receivedAt])
}

/// Lease lock for the marketing dispatcher (separate from the core
/// ScheduledTickLock so marketing can never stall or be stalled by ERP ticks).
model MarketingLock {
  id        String    @id
  lockedAt  DateTime?
  runId     String?
  updatedAt DateTime  @updatedAt
}

// =============================================================================
// Catalog inventory & accounting (distributor/contractor/retail pricing)
// =============================================================================
//
// NOTE: named CatalogProduct, not Product — a generic `model Product`
// already exists above (line ~330) and is deeply wired into
// quotes/sales-orders/invoices/purchasing/WooCommerce sync. This is a
// separate, independent catalog covering the full web product line (ovens,
// iron doors, refractory materials, accessories, tools, stains/enhancers)
// priced with distributor/contractor/retail tiers and landed-cost-based
// margins. It does not touch or relate to that model.

/// Top-level grouping across the whole catalog, independent of the
/// free-text `category` field (which stays available for a finer label,
/// e.g. category="42in Dome Oven" under categoryGroup=OVEN). OTHER is the
/// deliberate catch-all so an import never fails just because a product
/// doesn't cleanly fit one of the named groups.
enum CatalogCategoryGroup {
  OVEN
  IRON_DOOR
  REFRACTORY
  ACCESSORY
  TOOL
  STAIN_ENHANCER
  CUSTOM
  OTHER
}

/// How a given item actually ships. Most catalog items are small-parcel;
/// heavy/bulky items (a full pallet of dome ovens, brick pallets) ship LTL
/// freight instead, which is priced and handled completely differently —
/// see freightClass below.
enum ShippingMethod {
  PARCEL
  LTL_FREIGHT
}

model CatalogProduct {
  id                        String               @id @default(cuid())
  partNo                    String               @unique
  category                  String?
  categoryGroup             CatalogCategoryGroup @default(OTHER)
  productName               String
  description               String?

  // --- Physical specs ---
  pcsPerPallet              Int?
  weightLbs                 Decimal?             @db.Decimal(10, 2)
  dimensions                String?
  leadTimeDays              Int?

  // --- Cost breakdown (every direct cost that feeds totalLandedCost) ---
  acquisitionCost           Decimal              @db.Decimal(14, 2)
  freightCost               Decimal              @default(0) @db.Decimal(14, 2)
  importTaxesOrFees         Decimal              @default(0) @db.Decimal(14, 2)
  packagingCost             Decimal              @default(0) @db.Decimal(14, 2)
  // Percentage grossed onto the cost total (e.g. 2 = 2% of units lost to
  // breakage/shrinkage), not a flat dollar amount — see
  // recalculateProductFinancials in src/lib/inventory/profitability.ts.
  shrinkageLossRate         Decimal              @default(0) @db.Decimal(5, 2)
  // Card/web payment processor fee (e.g. 2.9% for Stripe), deducted from
  // the SELLING price when computing net profit — not part of landed cost.
  paymentProcessingFeeRate  Decimal              @default(2.9) @db.Decimal(5, 2)
  totalLandedCost           Decimal              @db.Decimal(14, 2)

  // --- Pricing tiers: markup-computed unless an override is set ---
  markupDistributor         Decimal              @default(20) @db.Decimal(5, 2)
  markupContractor          Decimal              @default(30) @db.Decimal(5, 2)
  markupRetail              Decimal              @default(40) @db.Decimal(5, 2)
  distributorPriceOverride  Decimal?             @db.Decimal(14, 2)
  contractorPriceOverride   Decimal?             @db.Decimal(14, 2)
  retailPriceOverride       Decimal?             @db.Decimal(14, 2)
  distributorPrice          Decimal              @db.Decimal(14, 2)
  contractorPrice           Decimal              @db.Decimal(14, 2)
  retailPrice               Decimal              @db.Decimal(14, 2)

  // --- Real-time profitability (after ALL costs, incl. payment fees) ---
  netProfitDist             Decimal              @db.Decimal(14, 2)
  netProfitCont             Decimal              @db.Decimal(14, 2)
  netProfitRet              Decimal              @db.Decimal(14, 2)
  trueMarginDist            Decimal              @db.Decimal(5, 2)
  trueMarginCont            Decimal              @db.Decimal(5, 2)
  trueMarginRet             Decimal              @db.Decimal(5, 2)

  // Shipping/freight variation (heavy-freight ovens vs. standard parcel
  // items): shippingMethod flags which pricing/handling regime applies,
  // freightClass holds the NMFC freight class code (e.g. "125") LTL
  // carriers quote by — meaningless/null for PARCEL items.
  shippingMethod            ShippingMethod       @default(PARCEL)
  freightClass              String?
  isActive                  Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  priceAuditLogs            CatalogPriceAuditLog[]

  @@index([category])
  @@index([categoryGroup])
  @@index([isActive])
}

model CatalogPriceAuditLog {
  id            String         @id @default(cuid())
  productId     String
  product       CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldCost       Decimal        @db.Decimal(14, 2)
  newCost       Decimal        @db.Decimal(14, 2)
  oldFreight    Decimal        @db.Decimal(14, 2)
  newFreight    Decimal        @db.Decimal(14, 2)
  triggerReason String?
  changedAt     DateTime       @default(now())

  @@index([productId])
}
