# =============================================================================
# CRM/ERP - Environment Variables
# Copy this file to .env (local dev) and fill in real values.
# On Easypanel, set these under the app's "Environment" tab. NEVER commit .env.
# =============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=production
# Port the Next.js server binds to (Easypanel injects PORT automatically)
PORT=3000

# Public base URL of this deployment (no trailing slash)
APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) --------------------------------------------------
# Local docker-compose default. On Easypanel, point this at your Postgres
# service's internal connection string, e.g.:
# postgres://postgres:PASSWORD@crm-postgres:5432/crm?schema=public
DATABASE_URL=postgresql://crm:crm_password@localhost:5432/crm_erp?schema=public

# ---- Auth (NextAuth) ---------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# ---- File storage ------------------------------------------------------------
# Absolute path (inside the container) where uploaded documents/PDFs are stored.
# Mount a persistent volume at this path on Easypanel.
UPLOADS_DIR=/app/uploads

# ---- Automations / cron ------------------------------------------------------
# Secret required to call POST /api/automations/run (trigger via Easypanel Cron
# or an external scheduler such as cron-job.org). Generate a random string.
CRON_SECRET=replace-with-a-random-secret

# ---- Outbound email (SMTP) used for system notifications, invoice delivery,
# payment reminders, order confirmations. Example uses a dev/test SMTP server;
# replace with your real provider (e.g. your own mail server, Postmark, SES).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM="CRM/ERP <no-reply@example.com>"

# ---- Inbound email (IMAP) default account used by the built-in Email Inbox
# module. Additional mailboxes can be added per-user from Settings > Email
# Accounts (credentials stored encrypted in the database).
IMAP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# ---- WhatsApp Business (Meta Cloud API) --------------------------------------
# Required only if you enable the WhatsApp module. See README.md
# "WhatsApp Business setup" for how to obtain these from Meta Business Manager.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Random string you choose; must match the "Verify Token" configured in the
# Meta App's Webhooks settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-string

# ---- WordPress integration ----------------------------------------------------
# Base URL of your WordPress site (no trailing slash)
WORDPRESS_URL=https://www.example.com
# Application Password user + password (WordPress Admin > Users > Profile >
# Application Passwords). Used for authenticated REST calls (form entries,
# WooCommerce). Leave blank to only sync public content anonymously.
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# Optional: shared secret configured in your WP contact form webhook (e.g.
# WPForms/Contact Form 7 + a webhook plugin) so the CRM can verify inbound
# lead payloads at /api/wordpress/leads/webhook
WORDPRESS_WEBHOOK_SECRET=replace-with-a-random-secret
# Optional: WooCommerce REST API keys (WooCommerce > Settings > Advanced > REST API)
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Optional: Stripe (see docs/STRIPE_INTEGRATION.md). STRIPE_SECRET_KEY is the
# server-side API key (Stripe Dashboard > Developers > API keys).
# STRIPE_WEBHOOK_SECRET is the signing secret for the /api/stripe/webhook
# endpoint specifically (Stripe Dashboard > Developers > Webhooks > your
# endpoint > Signing secret) — required for the app to trust any webhook
# request at all.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI-Assisted Features (see docs/AI_FEATURES.md) ---------------------------
# Anthropic API key (console.anthropic.com). Leave blank to disable AI
# features entirely — every AI route still works and returns the
# underlying facts, it just skips the AI-generated summary/draft and says
# so explicitly, rather than failing.
ANTHROPIC_API_KEY=
# Optional: override the model used for AI features (defaults to
# claude-sonnet-5 if unset).
ANTHROPIC_MODEL=

# ---- Marketing automation (see docs/MARKETING_AUTOMATION_ARCHITECTURE.md) ----
# Kill switch: the whole marketing module (UI, API, webhooks, dispatcher) is
# off unless this is exactly "true" (pages 404, API returns 503).
MARKETING_ENABLED=false
# Public https origin of THIS app as n8n/social platforms reach it. Used for
# n8n callback URLs, signed media URLs and one-click unsubscribe links.
MARKETING_PUBLIC_BASE_URL=https://crm.example.com
# Base URL of your n8n webhooks (no trailing slash). The CRM POSTs to
# {base}/social-publish and {base}/video-render — see n8n-workflows/README.md.
N8N_MARKETING_WEBHOOK_URL=https://n8n.example.com/webhook
# HMAC secrets, 32+ chars each (e.g. `openssl rand -hex 32`). Use DIFFERENT
# values: OUTBOUND signs CRM -> n8n requests, INBOUND signs n8n -> CRM
# callbacks and the scheduled dispatch trigger. Set the same two values in n8n.
MARKETING_N8N_OUTBOUND_SECRET=replace-with-32+-char-random-outbound-secret
MARKETING_N8N_INBOUND_SECRET=replace-with-32+-char-random-inbound-secret
# Creatomate video rendering. Set these on the N8N server (the video-render
# workflow reads them); the CRM itself never reads them. API key: Creatomate
# dashboard > Project settings > API key. Template: a template with elements
# named Product_Name, Price and Product_Image.
CREATOMATE_API_KEY=replace-with-creatomate-api-key
CREATOMATE_TEMPLATE_ID=replace-with-creatomate-template-id
# Signs time-limited public media URLs handed to n8n/platforms (32+ chars).
MARKETING_MEDIA_URL_SECRET=replace-with-32+-char-random-media-secret
# Signs per-recipient one-click unsubscribe links in marketing email (32+ chars).
MARKETING_UNSUBSCRIBE_SECRET=replace-with-32+-char-random-unsubscribe-secret
# Encryption key for marketing secrets at rest: 32 bytes as 64 hex chars or
# base64 (`openssl rand -hex 32`). KEY_ID labels it (default v1); on rotation
# move the old one to PREVIOUS_KEYS as "id:key,id:key" (decrypt only).
MARKETING_VAULT_KEY=replace-with-64-hex-chars
MARKETING_VAULT_KEY_ID=v1
MARKETING_VAULT_PREVIOUS_KEYS=
# Optional AI settings for campaign/content generation (uses ANTHROPIC_API_KEY).
# MARKETING_AI_MODEL overrides the default model; FALLBACK_MODEL is only used
# if set; SERVER_FALLBACKS=false disables server-side refusal fallbacks;
# TIMEOUT_MS defaults to 90000.
MARKETING_AI_MODEL=
MARKETING_AI_FALLBACK_MODEL=
MARKETING_AI_SERVER_FALLBACKS=
MARKETING_AI_TIMEOUT_MS=

# ---- Seed / bootstrap admin user (used by prisma/seed.ts on first run only) --
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="Admin User"
