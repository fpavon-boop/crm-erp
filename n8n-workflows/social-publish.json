    {
      "id": "6204b204-1546-9b21-2835-6dbcae7d2d75",
      "name": "Route by platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        20
      ],
      "parameters": {
        "jsCode": "// One item per platform branch; media[0] decides photo vs video (carousels post the first item).\nconst pkg = $input.first().json.pkg;\nconst media = (pkg.media || [])[0] || null;\nconst caption = pkg.post.caption || '';\nconst acct = pkg.account.externalAccountId;\nlet request = null;\nif (pkg.platform === 'FACEBOOK') {\n  if (media && media.type === 'VIDEO') request = { url: 'https://graph.facebook.com/v21.0/' + acct + '/videos', body: { file_url: media.url, description: caption } };\n  else if (media) request = { url: 'https://graph.facebook.com/v21.0/' + acct + '/photos', body: { url: media.url, caption } };\n  else request = { url: 'https://graph.facebook.com/v21.0/' + acct + '/feed', body: { message: caption } };\n} else if (pkg.platform === 'INSTAGRAM') {\n  if (media && media.type === 'VIDEO') request = { url: 'https://graph.facebook.com/v21.0/' + acct + '/media', body: { media_type: 'REELS', video_url: media.url, caption } };\n  else if (media) request = { url: 'https://graph.facebook.com/v21.0/' + acct + '/media', body: { image_url: media.url, caption } };\n} else if (pkg.platform === 'TIKTOK') {\n  if (media && media.type === 'VIDEO') {\n    request = {\n      url: 'https://open.tiktokapis.com/v2/post/publish/video/init/',\n      body: {\n        post_info: { title: caption.slice(0, 2200), privacy_level: $env.TIKTOK_PRIVACY_LEVEL || 'SELF_ONLY', disable_comment: false, disable_duet: false, disable_stitch: false },\n        source_info: { source: 'PULL_FROM_URL', video_url: media.url },\n      },\n    };\n  }\n}\nconst unsupported = request ? null : pkg.platform + ' needs ' + (pkg.platform === 'TIKTOK' ? 'a video' : 'an image or video') + ' for this workflow';\nreturn [{ json: { platform: pkg.platform, isVideo: !!(media && media.type === 'VIDEO'), request, unsupported } }];"
      }
    },
