      "typeVersion": 2,
      "position": [
        1560,
        220
      ],
      "parameters": {
        "jsCode": "// TikTok publishes asynchronously; the publish_id is the stable external reference.\nconst r = $input.first().json;\nconst err = r.error && r.error.code && r.error.code !== 'ok' ? r.error : null;\nif (err) throw new Error('TikTok: ' + err.code + ' ' + (err.message || ''));\nconst id = r.data && r.data.publish_id;\nif (!id) throw new Error('TikTok returned no publish_id: ' + JSON.stringify(r).slice(0, 500));\nreturn [{ json: { event: { type: 'post.published', data: { externalPostId: String(id) } } } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "7c915ab7-100d-2862-05eb-bd4ab5ee5ad4",
      "name": "Build post.failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        440
      ],
      "parameters": {
        "jsCode": "// Any failed platform call (after retries), unsupported media, or a result node error.\nconst err = $input.first().json.error;\nconst msg = typeof err === 'string' ? err : (err && (err.message || err.description)) || JSON.stringify($input.first().json).slice(0, 1000);\nconst unsupported = $('Route by platform').first().json.unsupported;\nreturn [{ json: { event: { type: 'post.failed', data: { error: String(unsupported || msg).slice(0, 4000) } } } }];"
      }
    },
    {
      "id": "ae05fe14-6d81-24e3-a673-63073e8e863c",
      "name": "Sign callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        100
      ],
      "parameters": {
        "jsCode": "// Signs a CRM callback with MARKETING_N8N_INBOUND_SECRET. The body sent must be\n// byte-identical to the signed string, so the HTTP node sends it as a raw body.\n// eventId is stable per execution + event type, so n8n retries dedupe in the CRM.\nconst crypto = require('crypto');\nconst secret = $env.MARKETING_N8N_INBOUND_SECRET;\nif (!secret || secret.length < 32) throw new Error('MARKETING_N8N_INBOUND_SECRET is not set on n8n');\nconst pkg = $('Verify CRM signature').first().json.pkg;\nconst url = (pkg.callback && pkg.callback.url) || (($env.CRM_BASE_URL || '').replace(/\\/$/, '') + '/api/marketing/webhooks/n8n');\nif (!/^https?:\\/\\//.test(url)) throw new Error('No callback URL: set MARKETING_PUBLIC_BASE_URL in the CRM or CRM_BASE_URL in n8n');\n\nconst { type, data } = $input.first().json.event;\nconst event = { eventId: $execution.id + ':' + type, type, jobId: pkg.jobId, data };\nconst body = JSON.stringify(event);\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\nreturn [{ json: { url, body, timestamp, signature, event } }];"
      }
    },
